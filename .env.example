APP_ENV=development
POSTGRES_USER=liven
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=liven
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=900
MOCK_OTP=true
DETECTOR_BACKEND=opencv
DEEPFACE_MODEL=VGG-Face
QR_CODE_EXPIRY_MINUTES=60

# E-mail: development para mock local; resend ou smtp para envio real com MOCK_OTP=false.
OTP_EMAIL_PROVIDER=development
RESEND_API_KEY=
OTP_EMAIL_FROM=
OTP_EMAIL_TIMEOUT_SECONDS=5

# Gmail SMTP: senha de app somente no .env privado; nunca versionar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Login normal por senha; OTP de login legado somente durante migração explícita.
LEGACY_OTP_LOGIN_ENABLED=false
LOGIN_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=900
